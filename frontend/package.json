{
  "name": "music-ingest-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "doctor": "npx react-doctor@latest",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "typecheck": "tsc -b",
    "check": "biome check src && tsc -b",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "react-doctor": "^0.9.13",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "vitest": "^4.1.10"
  }
}
