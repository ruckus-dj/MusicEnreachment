{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": { "enabled": true },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "!src/api/generated"]
  },
  "overrides": [
    {
      "includes": [
        "src/features/matchingWorkspace/sourceFileOrder.ts",
        "src/features/local-release/LocalReleaseEditor.tsx",
        "src/features/local-release/localReleaseFormModel.ts",
        "src/features/local-release/localReleaseMessages.ts",
        "src/features/operations/OperationsList.tsx",
        "src/features/sources/SourceRootList.tsx",
        "src/features/sources/SourceScanPanel.tsx",
        "src/routes/ShellView.tsx"
      ],
      "formatter": { "indentStyle": "tab" }
    }
  ]
}
