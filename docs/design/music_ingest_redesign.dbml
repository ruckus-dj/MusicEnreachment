Project music_ingest_redesign {
  database_type: 'PostgreSQL'

  Note: '''
    Концептуальная current-state схема Music Ingest; это не зеркальное описание
    runtime-таблиц или доказательство наличия соответствующих workers.
    История изменений и завершённые задания намеренно не хранятся.
    Ответы metadata providers являются долговременным локальным кэшем; остальные таблицы описывают только актуальные сущности,
    текущие проблемы и единственную действующую публикацию.
    Provider catalog (включая Local) и local collection независимы: deletion одного
    не удаляет записи другого. Collection deletion выполняется подтверждённой
    асинхронной service operation, которая сначала безопасно удаляет принадлежащие
    приложению managed output files и только затем удаляет publication/library
    rows. DB cascade не является filesystem cleanup; FK владения collection и
    publication используют RESTRICT против обхода workflow.
    Очереди, расписания и retries принадлежат River и хранятся в его внутренних таблицах;
    они намеренно не дублируются в этой domain-схеме.
  '''
}

Enum collection_sync_mode {
  release_groups
  releases
  full_discography
}

Enum source_root_status {
  unknown
  available
  unavailable
}

Enum source_processing_mode {
  in_place
  staged
}

Enum match_decision_method {
  automatic
  manual
}

Enum source_segment_kind {
  full_file
  cue
  manual
}

Enum lyrics_kind {
  plain
  synced
}

Table provider {
  id uuid [pk]
  code varchar(64) [not null, unique, note: 'musicbrainz, spotify, discogs, deezer, apple_music, embedded, manual, local; Local reuses this provider model and adds no tables (see docs/design/local-provider.md)']
  display_name text [not null]
  capabilities jsonb [not null, default: '{}']
  enabled boolean [not null, default: true]
}

Table provider_artist {
  id uuid [pk]
  provider_id uuid [not null]
  provider_key text [not null]
  name text [not null]
  disambiguation text
  genres jsonb [not null, default: '[]']
  tags jsonb [not null, default: '[]']
  extra_data jsonb [not null, default: '{}']
  refreshed_at timestamptz [not null]

  indexes {
    (provider_id, provider_key) [unique]
    (id, provider_id) [unique]
    name
  }
}

Table provider_release_artist {
  provider_release_id uuid [not null]
  position smallint [not null]
  provider_artist_id uuid [not null]

  indexes {
    (provider_release_id, position) [pk]
    (provider_release_id, provider_artist_id) [unique]
    provider_artist_id
  }
}

Table provider_release {
  id uuid [pk]
  provider_id uuid [not null]
  provider_key text [not null]
  release_group_key text [note: 'Provider-specific ключ группы разных изданий, если provider поддерживает это понятие']
  release_group_title text [not null]
  release_group_primary_type varchar(64) [note: 'Для Local вводится в форме; это тип группы релизов, не жанр']
  release_group_secondary_types jsonb [not null, default: '[]', note: 'Дополнительные типы; Local UI позволяет задать список']
  title text [not null]
  status varchar(64)
  packaging varchar(64)
  language varchar(16) [note: 'Язык релиза; поле script в Local форме не вводится']
  script varchar(16)
  country_code varchar(2)
  release_date varchar(10)
  barcode varchar(64)
  label text
  catalog_number text
  disambiguation text
  extra_data jsonb [not null, default: '{}']
  refreshed_at timestamptz [not null]

  indexes {
    (provider_id, provider_key) [unique]
    (id, provider_id) [unique]
    (provider_id, release_group_key)
    title
    status
  }
}

Table provider_recording_artist {
  provider_recording_id uuid [not null]
  position smallint [not null]
  provider_artist_id uuid [not null]

  indexes {
    (provider_recording_id, position) [pk]
    (provider_recording_id, provider_artist_id) [unique]
    provider_artist_id
  }
}

Table provider_recording {
  id uuid [pk]
  provider_id uuid [not null]
  provider_key text [not null]
  key_origin varchar(16) [not null, note: 'native или synthetic']
  title text [not null]
  duration_ms integer
  disambiguation text
  explicit boolean
  isrcs jsonb [not null, default: '[]']
  genres jsonb [not null, default: '[]']
  tags jsonb [not null, default: '[]']
  extra_data jsonb [not null, default: '{}']
  refreshed_at timestamptz [not null]

  indexes {
    (provider_id, provider_key) [unique]
    (id, provider_id) [unique]
    title
  }
}

Table provider_release_track {
  id uuid [pk]
  provider_id uuid [not null]
  provider_key text [not null, note: 'Native track ID или детерминированный release/disc/position key']
  provider_release_id uuid [not null]
  provider_recording_id uuid [not null]
  medium_number smallint [not null, note: 'Local поддерживает только один носитель (номер 1); это ограничение Local workflow, не общего provider-графа']
  medium_title text
  medium_format varchar(64)
  track_position integer [not null, note: 'Для Local порядок позиции; UI пересчитывает 1..n после add/remove/reorder']
  track_number text [not null, note: 'Отображаемый номер; может быть A1, DVD1-3 и т.п. Для Local равен автоматически вычисленному порядку 1..n']
  title_override text [note: 'Nullable override названия provider_recording только для этой позиции; применяется для всех providers']
  duration_override_ms integer [note: 'Nullable override duration_ms provider_recording только для этой позиции; применяется для всех providers. Local UI принимает секунды или М:СС']
  data_track boolean [not null, default: false]
  extra_data jsonb [not null, default: '{}']

  indexes {
    (provider_id, provider_key) [unique]
    (id, provider_id) [unique]
    (provider_release_id, medium_number, track_position) [unique]
    provider_release_id
    provider_recording_id
  }

  Note: 'provider_recording — самостоятельная композиция; provider_release_track — её позиция в конкретном provider-релизе. На позиции только title_override и duration_override_ms могут переопределять одноимённые поля recording. Metadata release, включая ALBUMARTIST, принадлежат provider_release; metadata композиции, включая ARTIST, — provider_recording. Автоматическое наследование и explicit-empty semantics для genres, tags, explicit и ISRC отдельно не определены.'
}

Table artwork_asset {
  id uuid [pk]
  provider_id uuid [not null]
  provider_item_id text [not null, note: 'Стабильный ID provider; при его отсутствии собственный UUID или ключ URL']
  source_media_variant_id uuid [note: 'Заполняется для embedded artwork; provider_item_id включает media variant и позицию изображения']
  image_data bytea [not null, note: 'Локально закэшированное изображение; PostgreSQL хранит большие значения через TOAST']
  mime_type varchar(128) [not null]
  width integer [not null]
  height integer [not null]
  byte_size bigint [not null]
  content_digest varchar(128) [note: 'Опциональный BLAKE3/другой digest для проверки целостности и поиска точных дубликатов']
  source_url text
  fetched_at timestamptz [not null]

  indexes {
    (provider_id, provider_item_id) [unique]
    content_digest
  }
}

Table release_artwork_candidate {
  id uuid [pk]
  collection_release_id uuid [not null]
  provider_release_id uuid [note: 'Необязательный provenance; NULL для embedded и manual artwork']
  artwork_asset_id uuid [not null]
  source_scope varchar(32) [not null, note: 'release, release_group, embedded или manual']
  image_kind varchar(32) [not null, note: 'front, back, booklet или other']
  source_kind varchar(32) [not null, note: 'digital, scan или unknown']
  quality_score integer [not null]
  provider_metadata jsonb [not null, default: '{}']
  added_at timestamptz [not null]

  indexes {
    (id, collection_release_id) [unique]
    (collection_release_id, artwork_asset_id) [unique]
    (collection_release_id, quality_score)
    provider_release_id
  }
}

Table source_root {
  id uuid [pk]
  configured_path text [not null, unique, note: 'Абсолютный server path; service дополнительно проверяет эквивалентные filesystem paths']
  display_name text [not null]
  processing_mode source_processing_mode [not null]
  status source_root_status [not null, default: 'unknown']
  scan_generation bigint [not null, default: 0]
  last_successful_scan_at timestamptz

  Note: 'Удаление root удаляет связанные source_location и source-инвентарь, но не физические файлы хоста, локальные entities или текущие publications. Удаление разрешено только после подтверждения точного configured_path и числа locations и при отсутствии активной операции root.'
}

Table media_variant {
  id uuid [pk, note: 'Конкретный технический вариант: FLAC, MP3, AAC, Opus и т.д.']
  source_sha256 bytea [note: 'NULL, когда глобальное вычисление SHA-256 было выключено; при наличии содержит ровно 32 bytes']
  container_format varchar(64) [not null]
  codec_name varchar(64) [not null]
  codec_profile varchar(128)
  lossless boolean [not null]
  duration_ms integer [not null]
  bit_rate bigint
  sample_rate integer
  sample_format varchar(32)
  bits_per_sample smallint
  channels smallint
  channel_layout varchar(64)
  audio_stream_count smallint [not null, default: 1]
  size_bytes bigint [not null]
  quality_score integer [not null]
  quality_policy_version integer [not null]
  analysis_policy_version integer [not null]
  ffprobe_json jsonb [not null]
  ffprobe_version varchar(64) [not null]
  observed_tags jsonb [not null, default: '{}', note: 'Нормализованные uppercase tag names; каждое значение всегда является массивом строк']
  inspected_at timestamptz [not null]
  chromaprint text [note: 'Fingerprint конкретного media variant; похожесть вычисляется при matching']
  chromaprint_hash bigint [note: 'Индексируемый SimHash/поисковый ключ для кандидатов']
  fingerprint_duration_ms integer
  fingerprint_algorithm integer
  fpcalc_version varchar(64)
  fingerprint_calculated_at timestamptz
  problem_flags bigint [not null, default: 0, note: 'Битовая маска стабильных технических проблем; значение бита после выпуска не переиспользуется']
  problem_details jsonb [not null, default: '{}', note: 'Текущие причины и evidence, ключованные именем problem flag']

  indexes {
    source_sha256 [unique]
    chromaprint_hash
    fingerprint_duration_ms
    (quality_score, codec_name)
  }

  Note: 'Для source_sha256 миграция добавляет CHECK octet_length(source_sha256) = 32. Для технических значений добавляются CHECK size_bytes > 0, duration_ms > 0, sample_rate > 0, channels > 0 и проверки остальных необязательных чисел на неотрицательность. Верхнего продуктового лимита длительности/размера нет. Variant с digest сохраняется как переиспользуемый cache без locations, в том числе после удаления последнего root-reference; orphan variant без digest удаляется service layer после завершения удерживающих операций и удаления последней ссылки. Удаление root очищает принадлежащие приложению staged-копии удаляемых источников. Для problem_flags миграция добавляет CHECK (problem_flags >= 0). Provider ambiguity и ошибки внешних сервисов сюда не входят.'
}

Table source_location {
  id uuid [pk]
  source_root_id uuid [not null]
  media_variant_id uuid [note: 'NULL, пока новый или изменённый файл ожидает успешного анализа']
  relative_path text [not null, note: 'Точное имя, полученное от filesystem; без безусловного case folding или Unicode normalization']
  size_bytes bigint [not null]
  mtime_ns bigint [not null]
  last_seen_scan_generation bigint [not null]
  observed_at timestamptz [not null]

  indexes {
    (source_root_id, relative_path) [unique]
    media_variant_id
  }

  Note: 'Строка существует только для пути, обнаруженного полностью успешным scan. Неувиденные locations удаляются при фиксации нового поколения; ошибочный или незавершённый scan ничего не удаляет. Удаление source_root удаляет все его locations. Миграция добавляет CHECK size_bytes >= 0. Несколько paths указывают на один variant только при доказанном одинаковом SHA-256.'
}

Table collection_artist {
  id uuid [pk]
  name text [not null]
  disambiguation text
  genres jsonb [not null, default: '[]']
  tags jsonb [not null, default: '[]']
  metadata_version integer [not null, default: 1]
  added_at timestamptz [not null]

  indexes {
    name
  }

  Note: 'Решение владельца 2026-10-29: идентичность MusicBrainz задаётся уникальным MBID через provider_artist.provider_key и collection_artist_provider_link, а не отдельным credit. Позднейшее уточнение того же дня: уникальность имени отложена и обеспечивается оператором вручную; автоматическое объединение по имени и DB-ограничение уникальности имени сейчас не требуются. Разные MBID могут иметь одинаковое имя. ALBUMARTIST задаёт связи артистов релиза, ARTIST — связи исполнителей recording/позиции. Composer/lyricist/vocalist/instrumentalist и другие ролевые значения остаются метаданными и не создают artist entity или дополнительную artist-связь. Уникальность provider identity и не более одной связи с каждым provider сохраняются.'
}

Table collection_release {
  id uuid [pk]
  title text [not null]
  release_type varchar(64)
  secondary_types jsonb [not null, default: '[]']
  release_date varchar(10)
  original_date varchar(10)
  country_code varchar(2)
  status varchar(64)
  packaging varchar(64)
  barcode varchar(64)
  label text
  catalog_number text
  disambiguation text
  genres jsonb [not null, default: '[]']
  tags jsonb [not null, default: '[]']
  extra_tags jsonb [not null, default: '{}']
  selected_artwork_candidate_id uuid
  metadata_version integer [not null, default: 1]
  artwork_version integer [not null, default: 1]
  publication_version integer [not null, default: 1]
  added_at timestamptz [not null]

  indexes {
    title
    release_date
  }

  Note: 'Локальный release существует без provider links. Выбранный artwork candidate обязан принадлежать этому collection release. Удаление release сначала обрабатывает managed publications его positions, затем удаляет positions и release; recordings, на которые ссылались positions, остаются самостоятельными.'
}

Table collection_release_artist {
  collection_release_id uuid [not null]
  collection_artist_id uuid [not null]
  position smallint [not null]

  indexes {
    (collection_release_id, position) [pk]
    (collection_release_id, collection_artist_id) [unique]
    collection_artist_id
  }
}

Table collection_recording {
  id uuid [pk]
  title text [not null]
  duration_ms integer
  disambiguation text
  explicit boolean
  isrcs jsonb [not null, default: '[]']
  genres jsonb [not null, default: '[]']
  tags jsonb [not null, default: '[]']
  metadata_version integer [not null, default: 1]
  added_at timestamptz [not null]

  indexes {
    title
  }
}

Table collection_recording_artist {
  collection_recording_id uuid [not null]
  collection_artist_id uuid [not null]
  position smallint [not null]

  indexes {
    (collection_recording_id, position) [pk]
    (collection_recording_id, collection_artist_id) [unique]
    collection_artist_id
  }
}

Table collection_track {
  id uuid [pk]
  collection_release_id uuid [not null]
  collection_recording_id uuid [not null]
  medium_number smallint [not null]
  medium_title text
  medium_format varchar(64)
  track_position integer [not null]
  track_number text [not null]
  title_override text
  duration_override_ms integer
  extra_tags jsonb [not null, default: '{}']
  metadata_version integer [not null, default: 1]
  publication_version integer [not null, default: 1, note: 'Увеличивается только когда текущий managed artifact действительно надо заменить']
  selected_lyrics_id uuid
  enabled boolean [not null, default: true]
  problem_flags bigint [not null, default: 0, note: 'Битовая маска актуальных track-level проблем; значения выпущенных битов не переиспользуются']
  problem_details jsonb [not null, default: '{}']

  indexes {
    (collection_release_id, medium_number, track_position) [unique]
    collection_recording_id
  }

  Note: 'collection_recording — самостоятельная композиция; collection_track — её позиция в collection-релизе. Только nullable title_override и duration_override_ms позиции переопределяют одноимённые значения recording. Metadata релиза, включая ALBUMARTIST, принадлежат collection_release; metadata композиции, включая ARTIST, — collection_recording. Для problem_flags миграция должна добавить CHECK (problem_flags >= 0) и partial indexes для часто используемых битов.'
}

Table collection_artist_provider_link {
  collection_artist_id uuid [not null]
  provider_id uuid [not null]
  provider_artist_id uuid [not null]
  decision_method match_decision_method [not null]
  decision_policy_version integer [note: 'Обязательно для automatic; NULL для manual']
  sync_mode collection_sync_mode
  sync_enabled boolean [not null, default: false]
  last_catalog_sync_at timestamptz

  indexes {
    (collection_artist_id, provider_id) [pk]
    provider_artist_id [unique]
  }
}

Table collection_release_provider_link {
  collection_release_id uuid [not null]
  provider_id uuid [not null]
  provider_release_id uuid [not null]
  decision_method match_decision_method [not null]
  decision_policy_version integer [note: 'Обязательно для automatic; NULL для manual']

  indexes {
    (collection_release_id, provider_id) [pk]
    provider_release_id [unique]
  }
}

Table collection_recording_provider_link {
  collection_recording_id uuid [not null]
  provider_id uuid [not null]
  provider_recording_id uuid [not null]
  decision_method match_decision_method [not null]
  decision_policy_version integer [note: 'Обязательно для automatic; NULL для manual']

  indexes {
    (collection_recording_id, provider_id) [pk]
    provider_recording_id [unique]
  }
}

Table collection_track_provider_link {
  collection_track_id uuid [not null]
  provider_id uuid [not null]
  provider_release_track_id uuid [not null]
  decision_method match_decision_method [not null]
  decision_policy_version integer [note: 'Обязательно для automatic; NULL для manual']

  indexes {
    (collection_track_id, provider_id) [pk]
    provider_release_track_id [unique]
  }
}

Table track_source {
  id uuid [pk]
  collection_track_id uuid [not null]
  media_variant_id uuid [not null, note: 'Один локальный media variant может быть назначен нескольким позициям треков в разных или одном релизе']
  decision_method match_decision_method [not null]
  decision_policy_version integer [note: 'Обязательно для automatic; NULL для manual']
  segment_kind source_segment_kind [not null, default: 'full_file']
  segment_start_ms integer
  segment_end_ms integer
  compatible boolean [not null, default: true]
  selected boolean [not null, default: false]
  attached_at timestamptz [not null]

  indexes {
    (collection_track_id, media_variant_id) [unique]
    (collection_track_id, selected)
  }

  Note: 'Связь collection_track ↔ media_variant является M:N. Один variant может быть source для tracks разных recordings/MBID. При удалении root удаляются source variants, лишившиеся всех locations; каскадно исчезают соответствующие track_source links, но collection_track и текущие публикации сохраняются. PostgreSQL migration должна добавить partial unique index UNIQUE(collection_track_id) WHERE selected и CHECK границ CUE/manual segment: start >= 0, end > start; full_file не имеет границ.'
}

Table match_candidate {
  id uuid [pk]
  media_variant_id uuid [not null]
  provider_release_track_id uuid [not null]
  confidence numeric(6,5) [not null, note: 'Нормализованный результат matching formula; выбор оператора его не изменяет']
  evidence jsonb [not null]
  matching_policy_version integer [not null]
  calculated_at timestamptz [not null]

  indexes {
    (media_variant_id, provider_release_track_id) [unique]
    (media_variant_id, confidence)
  }

  Note: 'Текущий набор кандидатов полностью заменяется при повторном matching. Миграция добавляет CHECK confidence >= 0 AND confidence <= 1. Fingerprint, tags, duration и другие признаки принадлежат evidence/formula, а не decision method.'
}

Table lyrics_document {
  id uuid [pk]
  language varchar(16)
  kind lyrics_kind [not null]
  provider_id uuid [not null]
  provider_key text [not null]
  content text [not null, note: 'Канонический plain text или LRC хранится непосредственно в PostgreSQL']
  duration_ms integer [note: 'Ожидаемая длительность особенно важна для synced lyrics']
  content_digest varchar(128)
  fetched_at timestamptz [not null]

  indexes {
    (provider_id, provider_key, kind) [unique]
  }
}

Table recording_lyrics {
  collection_recording_id uuid [not null]
  lyrics_document_id uuid [not null]
  compatibility varchar(32) [not null, note: 'exact, probable или manual']
  linked_at timestamptz [not null]

  indexes {
    (collection_recording_id, lyrics_document_id) [pk]
    lyrics_document_id
  }

  Note: 'M:N: один текст может подходить нескольким recordings, а recording может иметь несколько языков и вариантов lyrics.'
}

Table release_publication {
  collection_release_id uuid [pk]
  directory_path text [not null]
  artwork_asset_id uuid
  published_artwork_version integer [not null]
  published_version integer [not null]
  published_at timestamptz [not null]

  Note: 'Один текущий каталог публикации релиза. Уникальность публикации задаёт collection_release_id, а не directory_path: разные релизы могут использовать общий каталог, если полные пути их файлов не конфликтуют (решение владельца 2026-10-29). Удаление publication допускается только через async service operation: безопасное удаление принадлежащего приложению output file(s) предшествует удалению row; прямой SQL/cascade delete запрещён. Artwork не является отдельным файлом публикации: оно встраивается в аудиофайл позиции. Конфликт полного имени файла разрешает существующий flow стабильного position suffix с закреплением имени и удлинением при повторном конфликте; публикация чужой позиции не перезаписывается.'
}

Table track_publication {
  collection_track_id uuid [pk]
  collection_release_id uuid [not null]
  lyrics_id uuid
  source_quality_score integer [not null]
  source_quality_policy_version integer [not null]
  source_media_info jsonb [not null, note: 'Snapshot технических характеристик использованного источника; не FK на удаляемый source']
  relative_audio_path text [not null]
  output_container varchar(32) [not null]
  output_codec varchar(64) [not null]
  output_digest varchar(128) [note: 'Опциональный digest; периодическая проверка публикации не требует hash']
  published_size_bytes bigint [not null, note: 'Размер файла при регистрации фактического результата; неизменяемая база для stat-проверки']
  published_mtime_ns bigint [not null, note: 'mtime файла при регистрации фактического результата; неизменяемая база для stat-проверки']
  filesystem_problem varchar(16) [note: 'NULL при отсутствии известного расхождения; missing или drift после проверки зарегистрированного результата. Недоступность output root не означает missing и не меняет baseline.']
  published_version integer [not null]
  published_at timestamptz [not null]

  indexes {
    (collection_release_id, relative_audio_path) [unique]
  }

  Note: 'Публикация актуальна, когда published_version равен collection_track.publication_version. published_size_bytes и published_mtime_ns — baseline фактического аудиофайла при регистрации; периодический stat сравнивает оба значения, помечает missing/drift и никогда не принимает произвольный файл как новый baseline. Artwork и lyrics встроены в аудиофайл; отдельные файлы публикации для них не проверяются. Недоступный output root не считается missing. Период проверки не задан. Добавление или удаление source само по себе версию не меняет. Уникальность (collection_release_id, relative_audio_path) относится к одному релизу и сама по себе не предотвращает конфликт полных путей файлов разных релизов в общей папке; правило запрета перезаписи чужой позиции действует и между релизами. Publication tables содержат только текущий зарегистрированный результат; отдельные step journals, backups, prepared-result records и receipts отсутствуют. Удаление library entities выполняется async service operation, удаляющей managed output до строк публикаций; SQL/cascade delete не может удалять publication row. FK на collection_track и collection_release — RESTRICT. Незавершённая operation восстанавливается по известному frozen target: сначала читаются tags и technical parameters без транскодирования/full preparation и проверяются против operation inputs и текущей authority; при несовпадении выполняется обычный полный retry. Время файла не является доказательством успеха. First-publication recovery также использует frozen target operation, когда publication row ещё отсутствует; неизвестные файлы автоматически не сопоставляются.'
}

TableGroup provider_cache {
  provider
  provider_artist
  provider_release
  provider_release_artist
  provider_recording
  provider_recording_artist
  provider_release_track
  artwork_asset
  release_artwork_candidate
}

TableGroup source_inventory {
  source_root
  media_variant
  source_location
}

TableGroup local_collection {
  collection_artist
  collection_release
  collection_release_artist
  collection_recording
  collection_recording_artist
  collection_track
  collection_artist_provider_link
  collection_release_provider_link
  collection_recording_provider_link
  collection_track_provider_link
  track_source
  match_candidate
  lyrics_document
  recording_lyrics
}

TableGroup managed_publication {
  release_publication
  track_publication
}

